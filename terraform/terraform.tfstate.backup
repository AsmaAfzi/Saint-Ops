            "values": [
              "# saint-dev namespace — local Docker Desktop K8s / minikube\r\nglobal:\r\n  namespace: saint-dev\r\n\r\nbackend:\r\n  replicaCount: 2\r\n  image:\r\n    pullPolicy: Never\r\n  service:\r\n    type: ClusterIP\r\n  mlflow:\r\n    shadowTrafficPct: \"10\"\r\n\r\nfrontend:\r\n  replicaCount: 1\r\n  image:\r\n    pullPolicy: Never\r\n  service:\r\n    type: ClusterIP\r\n\r\nautoscaling:\r\n  enabled: true\r\n  minReplicas: 2\r\n  maxReplicas: 5\r\n  targetCPUUtilizationPercentage: 70\r\n  latency:\r\n    enabled: false\r\n\r\npersistence:\r\n  enabled: true\r\n  size: 10Gi\r\n  storageClass: \"\"\r\n\r\ningress:\r\n  enabled: false\r\n\r\ncronJobs:\r\n  driftReport:\r\n    schedule: \"0 8 * * *\"\r\n  dataFreshness:\r\n    maxAgeHours: 336\r\n\r\nrbac:\r\n  enabled: true\r\n\r\nnetworkPolicy:\r\n  enabled: true\r\n",
