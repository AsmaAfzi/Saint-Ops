    "demo_commands": {
      "value": "kubectl config use-context docker-desktop\r\nkubectl get pods -n saint-dev\r\nkubectl apply -f scripts/k8s_seed_pod.yaml\r\nkubectl wait --for=condition=Ready pod/seed-pvc -n saint-dev --timeout=120s\r\nkubectl cp ./data/. saint-dev/seed-pvc:/mnt/data/\r\nkubectl cp ./artifacts/. saint-dev/seed-pvc:/mnt/artifacts/\r\nkubectl cp ./models/. saint-dev/seed-pvc:/mnt/models/\r\nkubectl delete pod seed-pvc -n saint-dev\r\nkubectl port-forward -n saint-dev svc/saint-dev-saint-ops-frontend 3000:80\r\nkubectl port-forward -n saint-dev svc/saint-dev-saint-ops-backend 8000:8000\r\n",
      "type": "string"
    },
