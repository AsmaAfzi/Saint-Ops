                "name": "saint-dev",
                "namespace": "saint-dev",
                "notes": "SAINT-OPS deployed to namespace saint-dev.\r\n\r\n1. Get frontend URL:\r\n  kubectl port-forward svc/saint-dev-saint-ops-frontend 3000:80 -n saint-dev\r\n\r\n2. Get API URL:\r\n  kubectl port-forward svc/saint-dev-saint-ops-backend 8000:8000 -n saint-dev\r\n\r\n3. MLflow UI (internal):\r\n  kubectl port-forward svc/saint-dev-saint-ops-mlflow 5000:5000 -n saint-dev\r\n\r\n4. Seed PVC data (first install):\r\n  ./scripts/k8s_seed_data.sh saint-dev saint-dev-saint-ops\r\n\r\n5. HPA status:\r\n  kubectl get hpa -n saint-dev\r\n",
                "revision": 1,
                "values": "{\"autoscaling\":{\"enabled\":true,\"latency\":{\"enabled\":false},\"maxReplicas\":3,\"minReplicas\":1,\"targetCPUUtilizationPercentage\":70},\"backend\":{\"image\":{\"pullPolicy\":\"IfNotPresent\"},\"mlflow\":{\"shadowTrafficPct\":\"10\"},\"replicaCount\":1,\"service\":{\"type\":\"ClusterIP\"}},\"cronJobs\":{\"dataFreshness\":{\"maxAgeHours\":336},\"driftReport\":{\"schedule\":\"0 8 * * *\"}},\"frontend\":{\"image\":{\"pullPolicy\":\"Never\"},\"replicaCount\":1,\"service\":{\"type\":\"ClusterIP\"}},\"global\":{\"namespace\":\"saint-dev\"},\"ingress\":{\"enabled\":false},\"networkPolicy\":{\"enabled\":true},\"persistence\":{\"enabled\":true,\"size\":\"10Gi\",\"storageClass\":\"\"},\"rbac\":{\"enabled\":true}}",
