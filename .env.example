# Local filesystem artifacts (default)
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow/mlflow.db

# --- Optional: S3 / MinIO artifact store ---
# Start MinIO: docker compose --profile s3 up -d minio
# Create bucket "saint-mlflow" in MinIO console (http://localhost:9001)
# MLFLOW_ARTIFACT_ROOT=s3://saint-mlflow/artifacts
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=minio12345
# MLFLOW_S3_ENDPOINT_URL=http://minio:9000
# AWS_DEFAULT_REGION=us-east-1

# Registry lifecycle
MLFLOW_AUTO_STAGE=1
MLFLOW_AUTO_PROMOTE=0
MLFLOW_REQUIRE_APPROVAL=0
MLFLOW_PROMOTION_MIN_F1_DELTA=0.0

# Shadow / canary serving (0–100)
MLFLOW_SHADOW_TRAFFIC_PCT=0

# Retraining (Phase 6)
RETRAIN_ENV_DRIFT_WINDOWS=50
RETRAIN_MIN_F1=0.80
AIRFLOW_FERNET_KEY=saint_ops_demo_fernet_key_32b!!
